{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@pv/domain": ["../domain/src/index.ts"],
      "@pv/github": ["../github/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "vitest.config.ts"]
}

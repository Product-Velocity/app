# Copy to apps/web/.env.local for local development. Never commit real values.
# Real values live in Vercel (Project Settings > Environment Variables) and Supabase.
# Type in Vercel: NEXT_PUBLIC_* = Config, everything else = Secret.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Public origin used in sign-in redirects and invite links when it cannot be
# derived from the request (set to your production URL on Vercel Production).
# SITE_URL=https://your-domain.example

# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `pnpm db:migrate` only (Project Settings > Database > Connection string,
# direct or session pooler). Needed in CI/your shell, not in the web app runtime.
DATABASE_URL=

# Used by `pnpm db:test` only: a Postgres superuser URL for a THROWAWAY server.
# Each run creates and drops its own database. Never point this at Supabase.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

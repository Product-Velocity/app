{
  "ignoreCommand": "bash ../../tools/vercel/ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "regions": [
    "dub1"
  ],
  "crons": [
    {
      "path": "/api/cron/github",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/jira",
      "schedule": "30 5 * * *"
    }
  ]
}
